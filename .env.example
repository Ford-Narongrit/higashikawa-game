# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local)
# บน Vercel ให้ใส่ค่าเดียวกันที่ Project → Settings → Environment Variables

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
# (หรือ anon key ในแท็บ Legacy) — ปลอดภัยที่จะอยู่ฝั่ง client เพราะมี RLS คุม
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Supabase → Project Settings → API Keys → Secret key (sb_secret_...)
# (หรือ service_role key ในแท็บ Legacy) — ลับสุด ใช้เฉพาะฝั่งเซิร์ฟเวอร์
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# รหัสผ่านสำหรับหน้า /admin และ /screen (ตั้งเองให้ยาวและเดายาก)
ADMIN_PASSWORD=change-me

# URL ที่ deploy แล้ว ใช้ทำ QR บนจอเวที (ตอนพัฒนาใช้ http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
